<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: back up app data (including the vehicle key) only when
     client-side encryption with the device lock secret is available.
     Battery readings are live state, not settings: they stay on the device. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="battery-history.pb" />
        <exclude domain="file" path="battery-history.csv" />
        <exclude domain="file" path="battery-history.csv.imported" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="battery-history.pb" />
        <exclude domain="file" path="battery-history.csv" />
        <exclude domain="file" path="battery-history.csv.imported" />
    </device-transfer>
</data-extraction-rules>
