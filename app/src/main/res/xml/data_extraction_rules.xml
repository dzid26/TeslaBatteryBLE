<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: keep user data in backup/transfer, but never the pairing key material. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pairing_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pairing_key.xml" />
    </device-transfer>
</data-extraction-rules>
